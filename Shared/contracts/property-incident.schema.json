{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afrilife.invalid/contracts/property-incident.schema.json",
  "title": "AfriLife Property Incident",
  "type": "object",
  "required": ["incidentId", "ownerEntityId", "regionId", "type", "status"],
  "properties": {
    "incidentId": { "type": "string", "minLength": 1 },
    "ownerEntityId": { "type": "string", "minLength": 1 },
    "regionId": { "type": "string", "minLength": 1 },
    "type": {
      "enum": ["phone-theft", "wallet-theft", "vehicle-theft", "package-theft", "shop-theft", "home-burglary", "property-theft"]
    },
    "status": {
      "enum": ["reported", "under-review", "investigating", "recovered", "closed", "closed-unresolved"]
    },
    "recovered": { "type": "boolean" }
  }
}
